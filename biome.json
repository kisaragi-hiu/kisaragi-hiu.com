{
  "$schema": "https://biomejs.dev/schemas/1.6.3/schema.json",
  "organizeImports": {
    "enabled": false
  },
  "json": {
    "formatter": {
      "enabled": false
    }
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": { "noMultipleSpacesInRegularExpressionLiterals": "off" },
      "style": {
        "useTemplate": "off",
        "noNonNullAssertion": "off",
        "useNamingConvention": {
          "level": "warn",
          "options": { "strictCase": false, "requireAscii": false }
        }
      },
      "suspicious": { "noExplicitAny": "off" }
    }
  }
}
